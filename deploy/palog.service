[Unit]
Description=panabit log audit service (palog)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/palog
ExecStart=/opt/palog/palog -db /opt/palog/palog.db -udp :40200 -http 0.0.0.0:8080
Restart=always
RestartSec=3
# 波动大时静默 OOM 误杀日志刷屏
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
